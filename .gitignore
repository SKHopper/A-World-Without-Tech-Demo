# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
WorldWithout/SourceArt/**/*.png
WorldWithout/SourceArt/**/*.tga

# Binary Files
WorldWithout/Binaries/*
WorldWithout/Plugins/**/Binaries/*

# Builds
WorldWithout/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
WorldWithout/Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
WorldWithout/Saved/*

# Compiled source files for the engine to use
WorldWithout/Intermediate/*
WorldWithout/Plugins/**/Intermediate/*

# Cache files for the editor to use
WorldWithout/DerivedDataCache/*
